---
const { sideBarActiveItemID } = Astro.props;

const navItems = [
  { id: "home", href: "/", label: "Overview", icon: "fa-solid fa-house" },
  { id: "cv", href: "/cv", label: "CV", icon: "fa-solid fa-file-lines" },
  { id: "projects", href: "/projects", label: "Projects", icon: "fa-solid fa-folder-open" },
  { id: "tanyaCv", href: "/tanya-cv", label: "Tanya CV", icon: "fa-solid fa-robot" },
  {
    id: "contact",
    href: "mailto:reza.rr889@gmail.com",
    label: "Contact",
    icon: "fa-solid fa-envelope",
    external: true,
  },
];

const linkBaseClass =
  "group flex min-h-11 items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition";
const inactiveClass = "text-gray-600 hover:bg-gray-100 hover:text-gray-950";
const activeClass = "bg-gray-950 text-white shadow-sm hover:bg-gray-950";
---

<nav class="min-h-0 flex-1 overflow-y-auto px-3 py-4">
  <p class="mb-2 px-3 text-[11px] font-bold uppercase tracking-wider text-gray-400">
    Resume
  </p>
  <ul class="space-y-1">
    {
      navItems.map((item) => {
        const isActive = sideBarActiveItemID === item.id;

        return (
          <li>
            <a
              id={item.id}
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noreferrer" : undefined}
              referrerpolicy={item.external ? "no-referrer-when-downgrade" : undefined}
              aria-current={isActive ? "page" : undefined}
              class={`${linkBaseClass} ${isActive ? activeClass : inactiveClass}`}
            >
              <span
                class={`grid h-8 w-8 shrink-0 place-items-center rounded-md ${
                  isActive
                    ? "bg-white/15 text-white"
                    : "bg-gray-100 text-gray-500 group-hover:bg-white group-hover:text-gray-900"
                }`}
              >
                <i class={`${item.icon} text-sm`}></i>
              </span>
              <span class="truncate">{item.label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
