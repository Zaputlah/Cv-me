---
import { cvProfile } from "../data/cvProfile";
---

<div
  class="sticky top-0 z-30 flex h-16 w-full justify-center border-b border-gray-200 bg-white/95 text-gray-900 shadow-sm backdrop-blur lg:hidden"
>
  <div class="navbar">
    <div class="navbar-start">
      <label
        for="my-drawer"
        class="btn btn-square btn-ghost"
        aria-label="Buka menu"
      >
        <i class="fa-solid fa-bars text-lg"></i>
      </label>
    </div>
    <div class="navbar-center">
      <a class="text-base font-bold text-gray-950" href="/">
        {cvProfile.name}
      </a>
    </div>
    <div class="navbar-end"></div>
  </div>
</div>
