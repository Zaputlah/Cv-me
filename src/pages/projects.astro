---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cvProfile } from "../data/cvProfile";

export const prerender = true;

const projects = [
  {
    title: "PPID",
    type: "Government Information Portal",
    img: "/ppid.png",
    desc: "Website profil Pejabat Pengelola Informasi dan Dokumentasi dengan fokus pada informasi publik dan struktur halaman yang mudah diakses.",
    tags: ["Angular", "TypeScript", "HTML", "CSS"],
    url: "https://ppidweb-ts-9nxt-1bq969w4y-rezarr889s-projects.vercel.app/beranda",
  },
  {
    title: "Hospital Website",
    type: "Healthcare Website",
    img: "/Hospital.png",
    desc: "Website rumah sakit untuk menampilkan informasi layanan, profil, dan akses dashboard.",
    tags: ["React", "JWT", "Axios", "CSS"],
    url: "https://hospital-zaputlah.vercel.app/",
  },
  {
    title: "Layanan Hiburan Digital",
    type: "Streaming UI",
    img: "/layananhiburan.png",
    desc: "Interface aplikasi layanan hiburan digital dengan state management dan responsive layout.",
    tags: ["React", "Vite", "Redux", "Tailwind CSS"],
    url: "https://stream-verse-seven.vercel.app/",
  },
  {
    title: "Movie Catalog",
    type: "API Integration",
    img: "/movie.png",
    desc: "Katalog movie dengan integrasi API untuk menampilkan daftar film, rating, dan informasi pendukung.",
    tags: ["React", "Axios", "REST API", "CSS"],
    url: "https://movie-api-ivory.vercel.app/",
  },
];
---

<BaseLayout title={`${cvProfile.name} - Projects`} sideBarActiveItemID="projects">
  <section class="mx-auto w-full max-w-4xl space-y-8 pb-12">
    <div class="border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">
        Portfolio
      </p>
      <div class="mt-3 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <h1 class="text-4xl font-bold leading-tight text-gray-950 md:text-5xl">
            Selected Projects
          </h1>
          <p class="mt-3 max-w-2xl text-base leading-7 text-gray-600">
            Kumpulan project yang paling relevan untuk menunjukkan kemampuan
            frontend, API integration, dashboard, dan web application.
          </p>
        </div>
        <a
          class="inline-flex w-fit items-center gap-2 rounded-lg bg-gray-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-gray-800"
          href={cvProfile.downloadUrl}
          download
        >
          <i class="fa-solid fa-file-arrow-down"></i>
          Download CV
        </a>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((project) => (
          <article class="group overflow-hidden border border-gray-200 bg-white shadow-sm transition hover:border-blue-200 hover:shadow-md">
            <a href={project.url} target="_blank" rel="noreferrer" class="flex h-full flex-col">
              <div class="relative h-44 overflow-hidden bg-gray-100">
                <img
                  src={project.img}
                  alt={project.title}
                  class="h-full w-full object-cover object-top transition duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute left-3 top-3 rounded-md bg-white/95 px-3 py-1 text-xs font-semibold text-gray-800 shadow-sm">
                  {project.type}
                </div>
              </div>

              <div class="flex flex-1 flex-col p-5">
                <h2 class="text-xl font-bold text-gray-950">{project.title}</h2>
                <p class="mt-3 text-sm leading-6 text-gray-600">
                  {project.desc}
                </p>

                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="rounded-md bg-gray-100 px-2.5 py-1.5 text-xs font-semibold text-gray-600">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="mt-auto flex items-center justify-between border-t border-gray-100 pt-4 text-sm font-semibold text-blue-700">
                  <span>Open project</span>
                  <span class="grid h-8 w-8 place-items-center rounded-md bg-blue-50 transition group-hover:bg-blue-600 group-hover:text-white">
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                  </span>
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
