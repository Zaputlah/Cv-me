---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cvProfile } from "../data/cvProfile";

export const prerender = true;

const contactItems = [
  {
    label: "Email",
    value: cvProfile.email,
    href: `mailto:${cvProfile.email}`,
    icon: "fa-solid fa-envelope",
  },
  {
    label: "Location",
    value: cvProfile.location,
    href: "",
    icon: "fa-solid fa-location-dot",
  },
  ...cvProfile.links.map((link) => ({
    label: link.label,
    value: link.display,
    href: link.href,
    icon: link.label === "GitHub" ? "fa-brands fa-github" : "fa-brands fa-linkedin-in",
  })),
];

const mainExperiences = cvProfile.experiences;
const additionalExperiences = cvProfile.additionalExperience;
const skillGroups = cvProfile.skillGroups;
---

<BaseLayout title={`${cvProfile.name} - CV`} sideBarActiveItemID="cv">
  <section class="mx-auto w-full max-w-6xl pb-12 print:max-w-none print:pb-0">
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between lg:pr-40 print:hidden">
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">
        Curriculum Vitae
      </p>
      <div class="flex flex-col gap-2 sm:flex-row">
        <a
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-gray-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-gray-800"
          href={cvProfile.downloadUrl}
          download
        >
          <i class="fa-solid fa-file-arrow-down"></i>
          Download PDF
        </a>
        <a
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-800 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
          href="/tanya-cv"
        >
          <i class="fa-solid fa-robot"></i>
          Tanya CV AI
        </a>
      </div>
    </div>

    <article class="overflow-hidden border border-gray-200 bg-white text-gray-900 shadow-sm print:border-0 print:shadow-none">
      <header class="border-b border-gray-200 p-6 sm:p-8 print:p-0 print:pb-5">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(280px,340px)] lg:items-start">
          <div class="min-w-0">
            <h1 class="text-4xl font-bold leading-tight tracking-tight text-gray-950 sm:text-5xl print:text-3xl">
              {cvProfile.name}
            </h1>
            <p class="mt-2 text-xl font-semibold text-blue-700 print:text-base">
              {cvProfile.title}
            </p>
            <p class="mt-4 text-sm leading-7 text-gray-700 sm:text-base print:text-sm print:leading-6">
              {cvProfile.summary}
            </p>
          </div>

          <address class="grid min-w-0 gap-2 text-sm not-italic text-gray-700 sm:grid-cols-2 lg:grid-cols-1 print:text-xs">
            {
              contactItems.map((contact) =>
                contact.href ? (
                  <a
                    class="flex min-w-0 items-center gap-3 rounded-lg border border-gray-100 px-3 py-2 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 print:border-0 print:px-0 print:py-0"
                    href={contact.href}
                    target={contact.href.startsWith("http") ? "_blank" : undefined}
                    rel={contact.href.startsWith("http") ? "noreferrer" : undefined}
                  >
                    <i class={`${contact.icon} w-4 shrink-0 text-gray-400`}></i>
                    <span class="min-w-0 break-words [overflow-wrap:anywhere]">{contact.value}</span>
                  </a>
                ) : (
                  <span class="flex min-w-0 items-center gap-3 rounded-lg border border-gray-100 px-3 py-2 print:border-0 print:px-0 print:py-0">
                    <i class={`${contact.icon} w-4 shrink-0 text-gray-400`}></i>
                    <span class="min-w-0 break-words [overflow-wrap:anywhere]">{contact.value}</span>
                  </span>
                )
              )
            }
          </address>
        </div>
      </header>

      <div class="grid lg:grid-cols-[260px_1fr]">
        <aside class="space-y-8 border-b border-gray-200 p-6 sm:p-8 lg:border-b-0 lg:border-r print:border-r print:p-0 print:pr-5">
          <section>
            <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-gray-500">
              Core Skills
            </h2>
            <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-700">
              {
                cvProfile.coreCompetencies.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-600"></span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section>
            <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-gray-500">
              Technical Skills
            </h2>
            <div class="mt-4 space-y-5">
              {
                skillGroups.map((group) => (
                  <div>
                    <h3 class="text-sm font-bold text-gray-950">{group.title}</h3>
                    <p class="mt-1 text-sm leading-6 text-gray-700">
                      {group.skills.join(", ")}
                    </p>
                  </div>
                ))
              }
            </div>
          </section>

          <section>
            <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-gray-500">
              Education
            </h2>
            <div class="mt-4 space-y-4">
              {
                cvProfile.education.map((item) => (
                  <article>
                    <h3 class="text-sm font-bold text-gray-950">{item.degree}</h3>
                    <p class="mt-1 text-sm leading-6 text-gray-700">{item.school}</p>
                    <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-gray-500">
                      {[item.period, item.location].filter(Boolean).join(" | ")}
                    </p>
                  </article>
                ))
              }
            </div>
          </section>

          <section>
            <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-gray-500">
              Certifications
            </h2>
            <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-700">
              {
                cvProfile.certifications.map((certification) => (
                  <li>{certification}</li>
                ))
              }
            </ul>
          </section>
        </aside>

        <main class="space-y-9 p-6 sm:p-8 print:p-0 print:pl-5">
          <section>
            <div class="flex items-end justify-between gap-4 border-b border-gray-200 pb-3">
              <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-gray-500">
                Professional Experience
              </h2>
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                Latest first
              </span>
            </div>

            <div class="mt-5 space-y-7">
              {
                mainExperiences.map((experience) => (
                  <article>
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        <h3 class="text-lg font-bold leading-snug text-gray-950">
                          {experience.role}
                        </h3>
                        <p class="mt-1 text-sm font-semibold text-blue-700">
                          {[experience.company, experience.location].filter(Boolean).join(" | ")}
                        </p>
                      </div>
                      {experience.period && (
                        <p class="shrink-0 text-sm font-semibold text-gray-600">
                          {experience.period}
                        </p>
                      )}
                    </div>

                    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-gray-700">
                      {
                        experience.highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))
                      }
                    </ul>

                    {experience.technologies && experience.technologies.length > 0 && (
                      <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-gray-500">
                        Tech Stack: {experience.technologies.join(", ")}
                      </p>
                    )}
                  </article>
                ))
              }
            </div>
          </section>

          <section>
            <h2 class="border-b border-gray-200 pb-3 text-xs font-bold uppercase tracking-[0.18em] text-gray-500">
              Selected Projects
            </h2>
            <div class="mt-5 space-y-5">
              {
                cvProfile.selectedProjects.map((project) => (
                  <article>
                    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                      {project.url ? (
                        <a
                          class="text-base font-bold text-gray-950 hover:text-blue-700"
                          href={project.url}
                          target="_blank"
                          rel="noreferrer"
                        >
                          {project.title}
                        </a>
                      ) : (
                        <h3 class="text-base font-bold text-gray-950">{project.title}</h3>
                      )}
                      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                        {project.technologies.join(", ")}
                      </p>
                    </div>
                    <p class="mt-2 text-sm leading-6 text-gray-700">
                      {project.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </section>

          <section>
            <h2 class="border-b border-gray-200 pb-3 text-xs font-bold uppercase tracking-[0.18em] text-gray-500">
              Additional Experience
            </h2>
            <div class="mt-5 space-y-5">
              {
                additionalExperiences.map((experience) => (
                  <article>
                    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                      <h3 class="text-base font-bold text-gray-950">{experience.role}</h3>
                      <p class="text-sm font-semibold text-blue-700">{experience.company}</p>
                    </div>
                    <ul class="mt-2 list-disc space-y-2 pl-5 text-sm leading-6 text-gray-700">
                      {
                        experience.highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))
                      }
                    </ul>
                  </article>
                ))
              }
            </div>
          </section>
        </main>
      </div>
    </article>
  </section>
</BaseLayout>
