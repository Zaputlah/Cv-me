---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cvProfile } from "../data/cvProfile";

export const prerender = true;

const recentExperiences = cvProfile.experiences.slice(0, 3);
const primarySkillGroups = cvProfile.skillGroups.filter((group) =>
  ["Frontend", "Backend", "Database", "Mobile"].includes(group.title)
);
---

<BaseLayout title={`${cvProfile.name} - ${cvProfile.title}`} sideBarActiveItemID="home">
  <section class="mx-auto w-full max-w-6xl space-y-8 pb-12">
    <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(260px,320px)] lg:p-10">
        <div class="min-w-0">
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">
            Professional Overview
          </p>
          <h1 class="mt-5 max-w-3xl text-4xl font-bold leading-[0.98] tracking-tight text-gray-950 sm:text-5xl lg:text-6xl">
            {cvProfile.name}
          </h1>
          <p class="mt-4 text-2xl font-semibold text-gray-700">
            {cvProfile.title}
          </p>
          <p class="mt-7 max-w-4xl text-base leading-8 text-gray-600 lg:text-lg lg:leading-9">
            {cvProfile.summary}
          </p>
        </div>

        <aside class="grid content-start gap-3 text-sm text-gray-700 sm:grid-cols-3 lg:grid-cols-1">
          <a
            class="flex min-w-0 items-center gap-3 rounded-xl border border-gray-100 bg-white px-4 py-3 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
            href={`mailto:${cvProfile.email}`}
            aria-label={`Email ${cvProfile.email}`}
          >
            <i class="fa-solid fa-envelope w-5 shrink-0 text-gray-400"></i>
            <span class="min-w-0 break-all">{cvProfile.email}</span>
          </a>
          <span class="flex min-w-0 items-center gap-3 rounded-xl border border-gray-100 bg-white px-4 py-3">
            <i class="fa-solid fa-location-dot w-5 shrink-0 text-gray-400"></i>
            <span class="min-w-0">{cvProfile.location}</span>
          </span>
          <a
            class="flex min-w-0 items-center gap-3 rounded-xl border border-gray-100 bg-white px-4 py-3 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
            href={cvProfile.links[0].href}
            target="_blank"
            rel="noreferrer"
            aria-label="Open LinkedIn profile"
          >
            <i class="fa-brands fa-linkedin-in w-5 shrink-0 text-gray-400"></i>
            <span class="min-w-0">LinkedIn Profile</span>
          </a>
        </aside>
      </div>

      <div class="flex flex-col gap-3 border-t border-gray-200 px-6 py-5 sm:flex-row sm:flex-wrap sm:px-8 lg:px-10">
        <a
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-gray-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-gray-800"
          href="/cv"
        >
          <i class="fa-solid fa-file-lines"></i>
          View CV
        </a>
        <a
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-800 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
          href={cvProfile.downloadUrl}
          download
        >
          <i class="fa-solid fa-file-arrow-down"></i>
          Download PDF
        </a>
        <a
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-800 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
          href="/projects"
        >
          <i class="fa-solid fa-folder-open"></i>
          Projects
        </a>
      </div>
    </article>

    <section class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="border border-gray-200 bg-white p-6 shadow-sm">
        <div class="border-b border-gray-200 pb-3">
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">
            Experience
          </p>
          <h2 class="mt-1 text-2xl font-bold text-gray-950">
            Recent Roles
          </h2>
        </div>

        <div class="mt-5 space-y-5">
          {
            recentExperiences.map((experience) => (
              <article class="border-l-2 border-gray-200 pl-4">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="font-bold text-gray-950">{experience.role}</h3>
                  <p class="text-sm font-semibold text-gray-500">{experience.period}</p>
                </div>
                <p class="mt-1 text-sm font-semibold text-blue-700">
                  {experience.company}
                </p>
                <p class="mt-2 text-sm leading-6 text-gray-600">
                  {experience.highlights[0]}
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <aside class="space-y-6">
        <section class="border border-gray-200 bg-white p-6 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">
            Core Focus
          </p>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-700">
            {
              cvProfile.coreCompetencies.slice(0, 6).map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-600"></span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="border border-gray-200 bg-white p-6 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">
            Skills
          </p>
          <div class="mt-4 space-y-4">
            {
              primarySkillGroups.map((group) => (
                <div>
                  <h3 class="text-sm font-bold text-gray-950">{group.title}</h3>
                  <p class="mt-1 text-sm leading-6 text-gray-600">
                    {group.skills.slice(0, 6).join(", ")}
                  </p>
                </div>
              ))
            }
          </div>
        </section>
      </aside>
    </section>

    <section class="border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-3 border-b border-gray-200 pb-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">
            Selected Work
          </p>
          <h2 class="mt-1 text-2xl font-bold text-gray-950">
            Professional Projects
          </h2>
        </div>
        <a
          class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-blue-700 hover:text-blue-900"
          href="/projects"
        >
          View all
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {
          cvProfile.selectedProjects.map((project) => (
            <article>
              <h3 class="font-bold text-gray-950">{project.title}</h3>
              <p class="mt-2 text-sm leading-6 text-gray-600">
                {project.description}
              </p>
              <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-gray-500">
                {project.technologies.join(", ")}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </section>
</BaseLayout>
